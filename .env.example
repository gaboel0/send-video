# ─────────────────────────────────────────────────────────────
# SendVideo: variáveis de ambiente
# Copie para `.env` (na raiz do projeto) e preencha.
# NUNCA versione o arquivo .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# URL pública pela qual o navegador acessa a aplicação.
# Em dev, o Vite (porta 5173) faz proxy de /api para a API.
# Em produção, a API serve o frontend compilado no mesmo domínio.
PUBLIC_URL=http://localhost:5173

# Porta da API (Fastify)
API_PORT=4000

# Fuso horário de referência para agenda, calendário e relatórios
APP_TIMEZONE=America/Sao_Paulo

# Permite criar contas pela tela de cadastro.
# O primeiro usuário pode sempre se cadastrar; depois disso só se for true.
ALLOW_SIGNUP=false

# ── Segurança ────────────────────────────────────────────────
# Chave de 32 bytes em base64 para criptografar tokens OAuth (AES-256-GCM).
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Nome do cookie de sessão. Em produção (HTTPS) o cookie é Secure automaticamente.
SESSION_COOKIE_NAME=sendvideo_session
SESSION_TTL_DAYS=30

# ── Banco de dados (PostgreSQL) ──────────────────────────────
# `npm run db:local` sobe um Postgres embutido em localhost:5433 para desenvolvimento.
DATABASE_URL=postgresql://sendvideo:sendvideo@localhost:5433/sendvideo

# ── Fila de publicação ───────────────────────────────────────
# bullmq = produção (requer Redis 6.2+)
# pg     = sem Redis: o worker busca as publicações vencidas direto no Postgres
#          (útil em desenvolvimento ou em hospedagens sem Redis)
QUEUE_DRIVER=bullmq
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=3

# ── Armazenamento dos vídeos ─────────────────────────────────
# local = pasta no disco do servidor; s3 = qualquer storage compatível com S3
# (AWS S3, Cloudflare R2, MinIO, Backblaze B2, DigitalOcean Spaces...)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Tamanho máximo de upload (MB)
MAX_UPLOAD_MB=1024

# ── TikTok for Developers ────────────────────────────────────
# https://developers.tiktok.com/  →  Manage apps  →  seu app
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Precisa ser HTTPS e estar cadastrada no app (Login Kit → Redirect URI).
# Em dev, use um túnel (ex.: cloudflared) apontando para a porta 5173.
TIKTOK_REDIRECT_URI=https://SEU-DOMINIO/api/oauth/tiktok/callback
# direct = Direct Post (exige escopo video.publish aprovado)
# inbox  = envia como rascunho para a caixa de entrada do TikTok (escopo video.upload);
#          o usuário finaliza a publicação no app do TikTok.
TIKTOK_POST_MODE=direct

# ── Meta for Developers (Instagram + Facebook) ───────────────
# https://developers.facebook.com/apps  →  seu app
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5173/api/oauth/meta/callback
META_GRAPH_VERSION=v24.0
# Opcional: ID de configuração do "Facebook Login for Business".
# Se preenchido, é usado no lugar da lista de escopos.
META_LOGIN_CONFIG_ID=
